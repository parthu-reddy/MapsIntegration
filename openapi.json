  "components": {
    "schemas": {
      "DispatchOrderRequest": {
        "required": [
          "cityId",
          "restaurantCoords"
        ],
        "type": "object",
        "properties": {
          "cityId": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "type": "string"
          },
          "restaurantCoords": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[-+]?([1-8]?\\d(\\.\\d+)?|90(\\.0+)?),\\s*[-+]?(180(\\.0+)?|((1[0-7]\\d)|([1-9]?\\d))(\\.\\d+)?)$",
            "type": "string"
          }
        }
      },
      "SetAvailabilityRequest": {
        "required": [
          "available",
          "cityId",
          "driverId"
        ],
        "type": "object",
        "properties": {
          "cityId": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[A-Za-z0-9_\\-]+$",
            "type": "string"
          },
          "driverId": {
            "maxLength": 36,
            "minLength": 0,
            "pattern": "^[0-9a-fA-F\\-]{36}$",
            "type": "string"
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "UpdateLocationRequest": {
        "required": [
